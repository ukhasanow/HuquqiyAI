ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-5
# Zaxira provayder (ixtiyoriy): Anthropic ishlamasa Gemini'ga o'tiladi.
# Model nomini "-latest" bilan qoldiring: Google eski nomlarni yangi kalitlar
# uchun yopadi ("no longer available to new users") va zaxira jimgina o'ladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Ovozli xabarni matnga o'girish zaxirasi (ixtiyoriy). Asosiy provayder — Gemini
OPENAI_API_KEY=
ADMIN_PASSWORD=

# Telegram bot (ixtiyoriy — token bo'lmasa bot o'chiq, sayt oldingidek ishlaydi)
TELEGRAM_BOT_TOKEN=
# Ilovaning tashqi manzili; berilsa webhook avtomatik o'rnatiladi.
# Bo'sh qoldirilsa bot faqat lokal polling'da: python -m app.bot.polling
TELEGRAM_WEBHOOK_URL=
# Webhook so'rovi haqiqatan Telegram'dan ekanini tekshirish uchun tasodifiy satr
TELEGRAM_WEBHOOK_SECRET=

# Ovozli javob (TTS): gemini | yoq. GEMINI_API_KEY bilan bir xil kalit ishlatiladi.
# Ovozga faqat tavsiya qismi tushadi, matnli javob doim to'liq yuboriladi.
TTS_PROVAYDER=yoq
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Ovoz nomi: Kore, Charon va boshqalar (Gemini prebuilt voices)
GEMINI_TTS_OVOZ=Kore

# Telegram'da /statistika ko'ra oladigan chat ID lar (vergul bilan).
# O'z ID ingizni bilish uchun botga /id yozing.
TELEGRAM_ADMIN_IDLAR=

# Statistikani tashqarida saqlash (Render bepul tierda disk vaqtinchalik —
# har deploy va uxlab-uyg'onishda faylga yozilgani yo'qoladi).
# Upstash Redis REST ma'lumotlari; berilmasa data/statistika.json ishlatiladi.
STATISTIKA_KV_URL=
STATISTIKA_KV_TOKEN=
