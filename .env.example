ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-5
# Zaxira provayder (ixtiyoriy): Anthropic ishlamasa Gemini'ga o'tiladi
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Ovozli xabarni matnga o'girish zaxirasi (ixtiyoriy). Asosiy provayder — Gemini
OPENAI_API_KEY=
ADMIN_PASSWORD=

# Telegram bot (ixtiyoriy — token bo'lmasa bot o'chiq, sayt oldingidek ishlaydi)
TELEGRAM_BOT_TOKEN=
# Ilovaning tashqi manzili; berilsa webhook avtomatik o'rnatiladi.
# Bo'sh qoldirilsa bot faqat lokal polling'da: python -m app.bot.polling
TELEGRAM_WEBHOOK_URL=
# Webhook so'rovi haqiqatan Telegram'dan ekanini tekshirish uchun tasodifiy satr
TELEGRAM_WEBHOOK_SECRET=
